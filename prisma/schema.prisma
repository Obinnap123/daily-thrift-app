// ============================================================================
// Davchuks Daily Thrift Management System — Prisma Schema
// ============================================================================
// This file defines the database structure. It grows incrementally as we
// build each feature.
//
// Step 1: User model + Role enum (authentication foundation)
// Step 2: Customer profiles, agent assignment, and rotation audit trail
// Step 3: Agent & Customer Management (unique customer codes, passport photos)
// Step 4: Contribution tracking, daily reconciliation, Maturity/Payout module,
//         and the aggregate data behind the Admin/Agent dashboards & Reports.
//         NOTE: there is no "Withdrawal" model anywhere in this schema — the
//         thrift business model here is "save for a fixed cycle, then get
//         paid out once", not "withdraw anytime". The Payout model below is
//         the complete, deliberate replacement for that idea.
//
// Docs: https://pris.ly/d/prisma-schema
// ============================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// NOTE: Prisma 7 no longer reads the connection URL from this file.
// The URL is configured in `prisma.config.ts` (for CLI commands like
// migrate/studio) and passed to the driver adapter in `src/lib/prisma.ts`
// (for the running application). See https://pris.ly/d/config-datasource
datasource db {
  provider = "postgresql"
}

// ----------------------------------------------------------------------------
// Enums
// ----------------------------------------------------------------------------

/// Application-wide user roles. Determines which dashboard and permissions
/// a logged-in user gets.
enum Role {
  ADMIN // Full system access: manage agents, customers, reports, settings
  AGENT // Field collector: registers customers, records daily contributions
  CUSTOMER // Thrift contributor: views own savings progress and payout status
}

/// Outcome of a single day's collection attempt for one customer.
enum ContributionStatus {
  COLLECTED // The agent collected the customer's daily amount.
  MISSED // The agent visited (or the day passed) with no payment collected.
}

/// Lifecycle of a customer's savings cycle (ContributionPlan).
enum PlanStatus {
  ACTIVE // Still collecting daily contributions.
  COMPLETED // Required number of PAID days reached — ready for payout.
  PAID_OUT // Payout has been recorded; this cycle is closed.
}

/// How a completed payout was physically handed to the customer. Both are
/// manual, offline actions — this system only RECORDS which one was used,
/// it never moves money itself (see Payout model comment).
enum PayoutMethod {
  CASH
  BANK_TRANSFER
}

/// Review state of an agent's End-of-Day cash reconciliation report.
enum ReconciliationStatus {
  SUBMITTED // Agent has submitted; awaiting Admin review.
  APPROVED // Admin confirmed the report is correct.
  REJECTED // Admin flagged a discrepancy (see reviewNote).
}

// ----------------------------------------------------------------------------
// Models
// ----------------------------------------------------------------------------

/// Core user account used for authentication (NextAuth Credentials provider).
/// Every person who can log in — Admin, Agent, or Customer — has one of these.
///
/// Login rule (enforced in application code, see lib/auth.ts):
///   - ADMIN and AGENT log in with EMAIL + password.
///   - CUSTOMER logs in with PHONE NUMBER + password (customers frequently
///     don't have an email address in this business context).
model User {
  id           String    @id @default(cuid())
  name         String
  /// Required for ADMIN/AGENT (login credential). Optional for CUSTOMER.
  /// Nullable + unique: Postgres allows multiple NULLs under a unique
  /// constraint, so many customers can have no email simultaneously.
  email        String?   @unique
  /// Required for CUSTOMER (login credential). Optional for ADMIN/AGENT
  /// (kept as contact info only for staff — see login rule above).
  /// Stored in normalized form (digits + optional leading "+"), see
  /// lib/phone.ts#normalizePhone.
  phone        String?   @unique
  /// Hashed with bcryptjs — never store plain text passwords.
  passwordHash String
  role         Role      @default(CUSTOMER)
  /// Soft-disable a login without deleting the record (audit trail friendly).
  isActive     Boolean   @default(true)
  /// Timestamp of the last successful login, useful for admin oversight.
  lastLoginAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Present only when role = CUSTOMER. Holds thrift-specific fields
  /// (ID number, assigned agent) that don't apply to Admin/Agent accounts.
  customerProfile CustomerProfile?

  /// Present only when role = AGENT. The list of customers currently
  /// assigned to this agent for collection/management.
  managedCustomers CustomerProfile[] @relation("AgentCustomers")

  /// Assignment-log rows where this user was the PREVIOUS agent on a
  /// customer (before a rotation).
  assignmentLogsAsPreviousAgent AgentAssignmentLog[] @relation("AssignmentPreviousAgent")

  /// Assignment-log rows where this user became the NEW agent on a
  /// customer (after a rotation, or on initial registration).
  assignmentLogsAsNewAgent AgentAssignmentLog[] @relation("AssignmentNewAgent")

  /// Assignment-log rows this user personally performed (the Admin/Agent
  /// who clicked "register" or "reassign").
  assignmentLogsPerformed AgentAssignmentLog[] @relation("AssignmentChangedBy")

  /// Present only when role = AGENT. Every Contribution row this agent has
  /// personally logged (collected or missed) for any of their customers.
  contributionsCollected Contribution[] @relation("ContributionCollectedBy")

  /// Present only when role = AGENT. This agent's own End-of-Day
  /// reconciliation reports, one per calendar day submitted.
  reconciliationsSubmitted DailyReconciliation[] @relation("ReconciliationAgent")

  /// Present only when role = ADMIN. Reconciliation reports this admin has
  /// reviewed (approved or rejected).
  reconciliationsReviewed DailyReconciliation[] @relation("ReconciliationReviewedBy")

  /// Present only when role = ADMIN. Payouts this admin approved.
  payoutsApproved Payout[] @relation("PayoutApprovedBy")

  @@index([role])
  @@map("users")
}

/// Thrift-specific profile data for a CUSTOMER user. Kept as a separate
/// table (rather than extra nullable columns on User) because these fields
/// are meaningless for ADMIN/AGENT accounts — this keeps the User table
/// clean and makes the "a customer must have these fields" rule explicit
/// at the schema level.
model CustomerProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// National ID / voter's card / whatever identification the business
  /// uses to verify a customer. Must be unique — used to prevent the same
  /// person from being registered twice under different accounts.
  idNumber String @unique

  /// System-generated, human-friendly unique customer code (e.g.
  /// "DDT-000123"), assigned once at registration and never changed.
  /// Backed by a dedicated Postgres sequence (`customer_code_seq`, created
  /// in the migration SQL) so concurrent registrations can never collide —
  /// far safer than reading MAX(id)+1 in application code under load.
  /// Used on receipts, search, and as the customer-facing reference number.
  customerCode String @unique

  /// URL/path of the customer's uploaded passport photograph (stored via
  /// Cloudflare R2 in production; nullable because a customer may be
  /// registered before their photo is captured/uploaded).
  passportPhotoUrl String?

  /// The agent currently responsible for collecting this customer's daily
  /// contributions. Required — every customer must always have an agent.
  /// Changing this value (agent rotation) is only done through the
  /// reassignment service, which also writes an AgentAssignmentLog entry —
  /// never update this column directly.
  assignedAgentId String
  assignedAgent   User   @relation("AgentCustomers", fields: [assignedAgentId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Full history of agent assignments/rotations for this customer,
  /// newest first (see AgentAssignmentLog).
  assignmentLogs AgentAssignmentLog[]

  /// This customer's savings cycles over time. Normally exactly one ACTIVE
  /// plan at a time, plus zero or more historical COMPLETED/PAID_OUT ones
  /// from previous cycles (a customer can save, get paid out, then start a
  /// brand new cycle).
  contributionPlans ContributionPlan[]

  /// Every payout ever recorded for this customer (across all their
  /// completed cycles) — shown in their profile's payout history.
  payouts       Payout[]
  contributions Contribution[]

  @@index([assignedAgentId])
  @@map("customer_profiles")
}

/// Immutable audit trail of every agent assignment change for a customer —
/// including the very first assignment at registration time (previousAgentId
/// is null in that case). This is what makes agent "rotation" auditable
/// instead of just silently overwriting CustomerProfile.assignedAgentId.
model AgentAssignmentLog {
  id String @id @default(cuid())

  customerProfileId String
  customerProfile   CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)

  /// Null on the very first assignment (customer registration).
  previousAgentId String?
  previousAgent   User?   @relation("AssignmentPreviousAgent", fields: [previousAgentId], references: [id], onDelete: SetNull)

  newAgentId String
  newAgent   User   @relation("AssignmentNewAgent", fields: [newAgentId], references: [id], onDelete: Restrict)

  /// The Admin (or self-registering Agent) who performed this change.
  changedById String
  changedBy   User   @relation("AssignmentChangedBy", fields: [changedById], references: [id], onDelete: Restrict)

  /// Optional free-text reason ("Agent left the company", "Route
  /// rebalancing", etc.) shown in the audit trail.
  note String?

  createdAt DateTime @default(now())

  @@index([customerProfileId])
  @@map("agent_assignment_logs")
}

/// One savings "cycle" for a customer — the terms of what they've committed
/// to save, and where that cycle currently stands. A customer normally has
/// exactly one ACTIVE plan; once it's COMPLETED and PAID_OUT, a brand new
/// plan can be started for their next cycle (kept as a separate row rather
/// than reusing/resetting the old one, so payout history stays intact).
model ContributionPlan {
  id String @id @default(cuid())

  customerProfileId String
  customerProfile   CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)

  /// The amount the customer has committed to contribute each collection
  /// day. Decimal (not Float) — this is money, never approximate.
  dailyAmount Decimal @db.Decimal(12, 2)

  /// Number of PAID days required to complete this cycle (e.g. 31). Maturity
  /// is paid-day-based: a missed day pushes the expected finish date out
  /// rather than shortening how much the customer actually saves.
  durationDays Int @default(31)

  /// The first day this plan expects a contribution.
  startDate DateTime @db.Date

  /// Reference date only = startDate + durationDays, assuming zero missed
  /// days. Shown on the Savings Progress screen as "expected maturity date"
  /// — the ACTUAL day the plan reaches COMPLETED may be later if any days
  /// were missed (see ContributionPlanService for the real day-counting
  /// logic; this column is never used to gate payout eligibility).
  expectedMaturityDate DateTime @db.Date

  status PlanStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Every daily collection attempt (paid or missed) recorded against this
  /// specific cycle.
  contributions Contribution[]

  /// The payout for this cycle, once one has been recorded. A plan can have
  /// at most one payout — enforced by @unique on Payout.contributionPlanId.
  payout Payout?

  @@index([customerProfileId])
  @@index([status])
  @@map("contribution_plans")
}

/// One row per customer per calendar day — the atomic record of "did this
/// customer pay today, or not". This single table is the foundation for
/// almost every dashboard/report in the system: Agent Collection Summary,
/// End-of-Day Reconciliation's "expected cash", Customer Savings Progress,
/// and all date-range totals in Reports are all just aggregates over this
/// table, never separately-tracked numbers that could drift out of sync.
model Contribution {
  id String @id @default(cuid())

  contributionPlanId String
  contributionPlan   ContributionPlan @relation(fields: [contributionPlanId], references: [id], onDelete: Cascade)

  /// Denormalized on purpose: querying "this agent's collections today"
  /// would otherwise require joining through ContributionPlan ->
  /// CustomerProfile every time, on what is the single most frequently
  /// queried table in the system (every dashboard hits it).
  customerProfileId String
  customerProfile   CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)

  /// The agent who logged this entry (collected or missed).
  collectedById String
  collectedBy   User   @relation("ContributionCollectedBy", fields: [collectedById], references: [id], onDelete: Restrict)

  /// The calendar day this row covers (date-only, time truncated) — never
  /// the timestamp the agent happened to press "save".
  collectionDate DateTime @db.Date

  status ContributionStatus

  /// The amount actually collected. Null when status = MISSED. When
  /// COLLECTED, this is expected to equal the plan's dailyAmount at the time
  /// of collection, but is stored explicitly (not just inferred from the
  /// plan) so a historical record survives even if the plan's dailyAmount
  /// were ever edited later.
  amount Decimal? @db.Decimal(12, 2)

  /// Optional free-text note (e.g. "Customer traveling", "Partial cash on
  /// hand at visit").
  note String?

  createdAt DateTime @default(now())

  /// One collection decision per plan per day — prevents accidentally
  /// double-logging (or double-missing) the same customer on the same day.
  @@unique([contributionPlanId, collectionDate])
  @@index([customerProfileId])
  @@index([collectedById, collectionDate])
  @@index([collectionDate])
  @@map("contributions")
}

/// An agent's End-of-Day cash reconciliation for one calendar day: what they
/// physically collected in cash vs. what the system expects based on that
/// day's logged Contribution rows, submitted for Admin review.
model DailyReconciliation {
  id String @id @default(cuid())

  agentId String
  agent   User   @relation("ReconciliationAgent", fields: [agentId], references: [id], onDelete: Cascade)

  /// The calendar day this report covers.
  reconciliationDate DateTime @db.Date

  /// Snapshot of SUM(Contribution.amount) for this agent on this date, taken
  /// at submission time — stored explicitly (not recomputed live) so the
  /// report reflects what the agent actually saw and confirmed against,
  /// even if a Contribution were edited afterward.
  expectedCash Decimal @db.Decimal(12, 2)

  /// What the agent declares they are physically holding in cash.
  actualCash Decimal @db.Decimal(12, 2)

  /// Agent's own explanation for any gap between expected and actual (e.g.
  /// "Gave change from personal cash", "One customer paid twice by mistake").
  agentNote String?

  status ReconciliationStatus @default(SUBMITTED)

  /// The Admin who reviewed this report. Null while status = SUBMITTED.
  reviewedById String?
  reviewedBy   User?   @relation("ReconciliationReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  /// Admin's note on approval/rejection (e.g. why it was rejected).
  reviewNote String?
  reviewedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One reconciliation report per agent per day.
  @@unique([agentId, reconciliationDate])
  @@index([status])
  @@map("daily_reconciliations")
}

/// A completed, manually-paid-out savings cycle. This is the deliberate
/// replacement for a "Withdrawal" feature: customers never withdraw funds
/// mid-cycle through this system. A Payout can only be created once its
/// ContributionPlan has reached COMPLETED (all required days paid), and
/// creating this row is itself the "Mark as Paid" action — it flips the
/// linked plan's status to PAID_OUT in the same transaction.
///
/// ⚠️ No online payment integration: payoutMethod only RECORDS how the
/// money was handed over (cash in hand, or a bank transfer the agent/admin
/// made through their own banking app/branch) — this system never moves
/// money itself, and stores no bank account numbers or payment credentials.
model Payout {
  id String @id @default(cuid())

  /// One payout per cycle — enforced at the database level (a plan can't be
  /// paid out twice).
  contributionPlanId String           @unique
  contributionPlan   ContributionPlan @relation(fields: [contributionPlanId], references: [id], onDelete: Restrict)

  /// Denormalized for the same reason as Contribution.customerProfileId —
  /// lets "this customer's payout history" and Reports query this table
  /// directly without an extra join through ContributionPlan.
  customerProfileId String
  customerProfile   CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Restrict)

  /// Snapshot of the plan's total collected amount at the moment of payout —
  /// stored explicitly so the receipt/history stays stable and correct even
  /// if Contribution rows were somehow edited afterward.
  totalSavings Decimal @db.Decimal(12, 2)

  payoutMethod PayoutMethod

  /// The calendar day the money was actually handed over / transferred.
  payoutDate DateTime @db.Date

  /// The Admin who approved and recorded this payout.
  approvedById String
  approvedBy   User   @relation("PayoutApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)

  /// System-generated, human-friendly unique receipt number (e.g.
  /// "PR-000045"), backed by its own Postgres sequence (payout_receipt_seq)
  /// for the same atomicity reason as CustomerProfile.customerCode.
  receiptNumber String @unique

  /// Optional free-text reference (e.g. "Transferred via GTBank" — never a
  /// full account number or other sensitive payment credential).
  note String?

  createdAt DateTime @default(now())

  @@index([customerProfileId])
  @@index([payoutDate])
  @@map("payouts")
}
